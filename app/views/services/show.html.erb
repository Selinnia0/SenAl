<% content_for :title, @service.name %>

<h1><%= @service.name %></h1>

<dl>
  <dt>Entegrasyon anahtarı</dt>
  <dd><code><%= @service.integration_key %></code></dd>
  <dt>Eskalasyon politikası</dt>
  <dd>
    <%= @service.escalation_policy.name %>:
    <%= @service.escalation_policy.escalation_levels.includes(:schedule).map { |level|
          "#{level.position + 1}. #{level.schedule.name} (#{level.timeout_minutes} dk)" }.join(" → ") %>
    · <%= @service.escalation_policy.repeat_count %> tur tekrar
  </dd>
  <dt>"Gördüm" sıfırlama süresi</dt>
  <dd><%= @service.ack_reset_minutes %> dakika</dd>
</dl>

<section>
  <h2>Deneme alarmı gönder</h2>
  <p><small>Terminal açmadan alarm göndermek için. API ile aynı kurallar işler (aynı <code>dedup_key</code> → yeni olay açılmaz).</small></p>
  <%= form_with scope: :alert, url: test_alert_service_path(@service) do |form| %>
    <%= form.label :summary, "Başlık" %>
    <%= form.text_field :summary, required: true, value: "db1 disk %95" %>

    <%= form.label :severity, "Önem (critical/error → yüksek aciliyet, eskale edilir)" %>
    <%= form.select :severity, [ [ "critical (yüksek)", "critical" ], [ "error (yüksek)", "error" ], [ "warning (düşük)", "warning" ], [ "info (düşük)", "info" ] ] %>

    <%= form.label :dedup_key, "Tekilleştirme anahtarı (boşsa rastgele)" %>
    <%= form.text_field :dedup_key, placeholder: "ör. disk-full-db1" %>

    <%= form.submit "Alarm gönder" %>
  <% end %>
</section>

<section data-controller="clipboard">
  <h2>Örnek alarm</h2>
  <pre data-clipboard-target="source">curl -X POST <%= api_v1_events_url %> \
  -H "Authorization: Token token=<%= @service.integration_key %>" \
  -H "Content-Type: application/json" \
  -d '{"event_action":"trigger","dedup_key":"disk-full-db1","summary":"db1 disk %95","severity":"critical"}'</pre>
  <button type="button" data-action="clipboard#copy">Kopyala</button>
  <p><small>Çözmek için aynı <code>dedup_key</code> ile <code>"event_action":"resolve"</code> gönderin.</small></p>
</section>

<div class="inline-actions">
  <%= link_to "Düzenle", edit_service_path(@service) %>
  <%= button_to "Sil", service_path(@service), method: :delete %>
</div>
