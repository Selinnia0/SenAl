<% content_for :title, @service.name %>

<%= render layout: "components/page_header", locals: { eyebrow: "Servis", title: @service.name,
      lead: "Alarmlar bu servisin entegrasyon anahtarıyla gelir ve eskalasyon politikasına göre nöbetçiye gider." } do %>
  <%= link_to "Düzenle", edit_service_path(@service), class: btn_class(:secondary) %>
  <%= button_to "Sil", service_path(@service), method: :delete, class: btn_class(:ghost) %>
<% end %>

<div class="detail-grid">
  <div>
    <%= render layout: "components/card", locals: { title: "Deneme alarmı gönder" } do %>
      <p class="muted">Terminal açmadan alarm göndermek için. API ile aynı kurallar işler (aynı <code>dedup_key</code> → yeni alarm açılmaz).</p>
      <%= form_with scope: :alert, url: test_alert_service_path(@service) do |form| %>
        <div class="field">
          <%= form.label :summary, "Başlık" %>
          <%= form.text_field :summary, required: true, value: "db1 disk %95" %>
        </div>
        <div class="row">
          <div class="field" style="flex: 1; min-width: 200px">
            <%= form.label :severity, "Önem" %>
            <%= form.select :severity, [ [ "critical (yüksek, eskale edilir)", "critical" ], [ "error (yüksek, eskale edilir)", "error" ], [ "warning (düşük)", "warning" ], [ "info (düşük)", "info" ] ] %>
          </div>
          <div class="field" style="flex: 1; min-width: 200px">
            <%= form.label :dedup_key, "Tekilleştirme anahtarı" %>
            <%= form.text_field :dedup_key, placeholder: "boşsa rastgele" %>
          </div>
        </div>
        <%= form.submit "Alarm gönder", class: btn_class(:primary) %>
      <% end %>
    <% end %>

    <%= render layout: "components/card", locals: { title: "API ile alarm" } do %>
      <div data-controller="clipboard">
        <pre data-clipboard-target="source">curl -X POST <%= api_v1_events_url %> \
  -H "Authorization: Token token=<%= @service.integration_key %>" \
  -H "Content-Type: application/json" \
  -d '{"event_action":"trigger","dedup_key":"disk-full-db1","summary":"db1 disk %95","severity":"critical"}'</pre>
        <button type="button" class="<%= btn_class(:secondary, size: :sm) %>" data-action="clipboard#copy">Kopyala</button>
      </div>
      <p class="muted" style="margin-top: var(--sa-space-3)">Çözmek için aynı <code>dedup_key</code> ile <code>"event_action":"resolve"</code> gönderin.</p>
    <% end %>
  </div>

  <aside aria-label="Servis ayarları">
    <%= render layout: "components/card", locals: { title: "Entegrasyon anahtarı" } do %>
      <p><code><%= @service.integration_key %></code></p>
      <p class="muted">Gizli tutun: bu anahtarı bilen herkes bu servis adına alarm gönderebilir.</p>
    <% end %>

    <%= render layout: "components/card", locals: { title: "Eskalasyon" } do %>
      <p class="muted"><%= @service.escalation_policy.name %> · <%= @service.escalation_policy.repeat_count %> tur tekrar</p>
      <ol class="plain-list">
        <% @service.escalation_policy.escalation_levels.includes(:schedule).each do |level| %>
          <li><span class="mono">Seviye <%= level.position + 1 %></span> · <%= link_to level.schedule.name, level.schedule %> · <span class="mono"><%= level.timeout_minutes %> dk</span></li>
        <% end %>
      </ol>
      <dl class="roles">
        <dt>"Gördüm" sıfırlama süresi</dt>
        <dd class="mono"><%= @service.ack_reset_minutes %> dakika</dd>
      </dl>
    <% end %>
  </aside>
</div>
