<div class="card form-card">
  <%= render "shared/errors", record: service %>
  <%= form_with model: service do |form| %>
    <div class="field">
      <%= form.label :name, "Ad" %>
      <%= form.text_field :name, required: true %>
    </div>
    <div class="field">
      <%= form.label :escalation_policy_id, "Eskalasyon politikası" %>
      <%= form.collection_select :escalation_policy_id, EscalationPolicy.order(:name), :id, :name %>
    </div>
    <div class="field">
      <%= form.label :ack_reset_minutes, '"Gördüm" sıfırlama süresi (dakika)' %>
      <%= form.number_field :ack_reset_minutes, min: 1 %>
      <p class="field__hint">"Gördüm" denip bu süre içinde çözülmeyen alarm yeniden tetiklenir.</p>
    </div>
    <%= form.submit "Kaydet", class: btn_class(:primary) %>
  <% end %>
</div>
