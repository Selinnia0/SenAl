<% content_for :title, "Şifremi unuttum" %>

<article>
  <h1>Şifrenizi mi unuttunuz?</h1>

  <%= form_with url: passwords_path do |form| %>
    <%= form.label :email_address, "E-posta adresi" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>

    <%= form.submit "Sıfırlama talimatlarını gönder" %>
  <% end %>
</article>
