<% content_for :title, "Akademik takvim" %>

<%= render layout: "components/page_header", locals: { eyebrow: "Nöbet · yönetim", title: "Akademik takvim",
      lead: "Sınav haftası, bayram ve dönem arası. Bu dönemlerde ilgili kişiler bütün nöbet takvimlerinde otomatik atlanır. İlk ve son gün dahil." } do %>
  <%= link_to "Yeni dönem", new_blackout_period_path, class: btn_class(:primary) %>
<% end %>

<% if @blackout_periods.any? %>
  <%= render layout: "components/table", locals: { headers: [ "Ad", "Tür", "Kimlere", "İlk gün", "Son gün", "" ] } do %>
    <% @blackout_periods.each do |period| %>
      <tr>
        <td><%= period.name %></td>
        <td><%= badge(enum_label(period, :kind), tone: :info, dot: false) %></td>
        <td><%= badge(enum_label(period, :applies_to), tone: (period.everyone? ? :major : :neutral), dot: false) %></td>
        <td class="mono"><%= format_date(period.starts_on) %></td>
        <td class="mono"><%= format_date(period.ends_on) %></td>
        <td>
          <div class="inline-actions">
            <%= link_to "Düzenle", edit_blackout_period_path(period), class: btn_class(:ghost, size: :sm) %>
            <%= button_to "Sil", blackout_period_path(period), method: :delete, class: btn_class(:ghost, size: :sm) %>
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
<% else %>
  <%= render "components/empty_state", message: "Tanımlı akademik dönem yok.", action_label: "Yeni dönem", action_path: new_blackout_period_path %>
<% end %>
