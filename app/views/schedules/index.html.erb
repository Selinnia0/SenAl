<% content_for :title, "Takvimler" %>

<%= render layout: "components/page_header", locals: { eyebrow: "Nöbet", title: "Nöbet takvimleri",
      lead: "İzinli kişiler ve akademik kapanma dönemleri bütün takvimlerde otomatik atlanır." } do %>
  <%= link_to "Müsaitliğim", unavailabilities_path, class: btn_class(:secondary) %>
<% end %>

<%= render layout: "components/table", locals: { headers: [ "Takvim", "Üyeler (sırayla)", "Rotasyon", "Şu an nöbetçi" ] } do %>
  <% @schedules.each do |schedule| %>
    <% on_call = OnCall.for(schedule, at: Time.current) %>
    <tr class="<%= "gap" unless on_call %>">
      <td><%= link_to schedule.name, schedule %></td>
      <td><%= schedule.members.map(&:name).join(", ") %></td>
      <td class="mono"><%= schedule.rotation_days %> gün</td>
      <td><%= on_call ? on_call.name : badge("Boşluk", tone: :critical) %></td>
    </tr>
  <% end %>
<% end %>
