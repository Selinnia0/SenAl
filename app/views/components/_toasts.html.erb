<%# Flash mesajları sağ üstte toast. Faz E'de Turbo Stream ile de eklenecek (id="toasts"). %>
<div class="toasts" id="toasts">
  <% flash.each do |type, message| %>
    <div role="alert" class="toast toast--<%= type %> flash-<%= type %>" data-controller="toast">
      <div class="toast__body"><%= message %></div>
      <button type="button" class="toast__close" data-action="toast#dismiss" aria-label="Kapat">×</button>
    </div>
  <% end %>
</div>
