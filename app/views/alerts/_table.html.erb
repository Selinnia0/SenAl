<%# locals: (alerts:) -%>
<%= render layout: "components/table", locals: { headers: [ "Kimlik", "Başlık", "Servis", "Durum", "Aciliyet", "Atanan", "Seviye", "Açılış" ] } do %>
  <% alerts.each do |alert| %>
    <tr>
      <td class="mono"><%= link_to "##{alert_ref(alert)}", alert %></td>
      <td><%= link_to alert.title, alert %></td>
      <td><%= alert.service.name %></td>
      <td><%= alert_status_badge(alert) %></td>
      <td><%= urgency_badge(alert) %></td>
      <td><%= alert.assignee&.name || "—" %></td>
      <td class="mono"><%= alert.current_level + 1 %>/<%= alert.escalation_round + 1 %></td>
      <td><%= mono_time(alert.triggered_at) %></td>
    </tr>
  <% end %>
<% end %>
