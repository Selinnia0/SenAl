<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= [ content_for(:title), "SenAl" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="SenAl">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%# Sınıfsız CSS: build adımı yok, CDN'den gelir %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.classless.min.css">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav>
        <ul>
          <li><strong><%= link_to "SenAl", root_path %></strong></li>
        </ul>
        <% if authenticated? %>
          <ul>
            <li><%= link_to "Pano", root_path %></li>
            <li><%= link_to "Olaylar", incidents_path %></li>
            <li><%= link_to "Takvimler", schedules_path %></li>
            <li><%= link_to "Müsaitliğim", unavailabilities_path %></li>
            <li><%= link_to "Bildirimlerim (#{Current.user.notifications.unread.count})", notifications_path %></li>
            <% if Current.user.manager? %>
              <li><%= link_to "Servisler", services_path %></li>
              <li><%= link_to "Akademik takvim", blackout_periods_path %></li>
              <% if TimeSkip.enabled? %>
                <li><%= link_to "Zaman sıçraması", new_time_skip_path %></li>
              <% end %>
            <% end %>
          </ul>
          <ul>
            <li><small><%= Current.user.name %> · <%= enum_label(Current.user, :role) %></small></li>
            <li><%= button_to "Çıkış", session_path, method: :delete %></li>
          </ul>
        <% end %>
      </nav>
    </header>

    <main>
      <% flash.each do |type, message| %>
        <div role="alert" class="flash-<%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
