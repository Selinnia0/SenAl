<!DOCTYPE html>
<html lang="tr">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <%= render "components/toasts" %>

    <div class="shell">
      <aside class="sidebar" data-controller="menu" data-open="false">
        <div class="sidebar__head">
          <%= render "components/logo", path: dashboard_path %>
          <button type="button" class="btn btn--ghost btn--sm sidebar__toggle" data-menu-target="button"
                  data-action="menu#toggle" aria-expanded="false" aria-controls="sidebar-nav">Menü</button>
        </div>

        <nav class="sidebar__nav" id="sidebar-nav" aria-label="Ana menü">
          <div class="sidebar__group">
            <%= sidebar_link "Pano", dashboard_path %>
            <%= sidebar_link "Bildirimlerim", notifications_path, count: Current.user.notifications.unread.count %>
          </div>

          <div class="sidebar__group">
            <span class="eyebrow">Müdahale</span>
            <%= sidebar_link "Olaylar", incidents_path %>
            <%= sidebar_link "Alarmlar", alerts_path %>
            <%= sidebar_link "Post-incident", post_incident_path %>
          </div>

          <div class="sidebar__group">
            <span class="eyebrow">Nöbet</span>
            <%= sidebar_link "Takvimler", schedules_path %>
            <%= sidebar_link "Müsaitliğim", unavailabilities_path %>
            <% if Current.user.manager? %>
              <%= sidebar_link "Akademik takvim", blackout_periods_path %>
            <% end %>
          </div>

          <% if Current.user.manager? %>
            <div class="sidebar__group">
              <span class="eyebrow">Yönetim</span>
              <%= sidebar_link "Servisler", services_path %>
              <% if TimeSkip.enabled? %>
                <%= sidebar_link "Zaman sıçraması", new_time_skip_path %>
              <% end %>
            </div>
          <% end %>

          <div class="sidebar__group">
            <span class="eyebrow">Halka açık</span>
            <%= sidebar_link "Status page", status_page_path %>
          </div>
        </nav>

        <div class="sidebar__user">
          <div class="sidebar__user-name"><%= Current.user.name %></div>
          <div class="muted"><%= enum_label(Current.user, :role) %></div>
          <%= button_to "Çıkış", session_path, method: :delete, class: btn_class(:ghost, size: :sm) %>
        </div>
      </aside>

      <div>
        <header class="topbar">
          <%= form_with url: incidents_path, method: :get, class: "topbar__search", role: "search" do %>
            <label for="topbar-search" class="visually-hidden">Olay ara</label>
            <input id="topbar-search" type="search" name="q" placeholder="Olay ara…" value="<%= params[:q] if controller_name == "incidents" %>">
            <input type="hidden" name="status" value="all">
          <% end %>
          <%= link_to "Olay ilan et", new_incident_path, class: btn_class(:accent) %>
        </header>

        <main class="main" id="main">
          <div class="main__inner">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
