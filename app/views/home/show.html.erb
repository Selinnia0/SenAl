<% content_for :title, "Pano" %>

<h1>SenAl</h1>

<section>
  <h2>Şu an nöbetçi</h2>
  <table>
    <thead>
      <tr><th>Takvim</th><th>Nöbetçi</th></tr>
    </thead>
    <tbody>
      <% @on_calls.each do |schedule, user| %>
        <tr class="<%= "gap" unless user %>">
          <td><%= link_to schedule.name, schedule %></td>
          <td><%= user ? user.name : "Boşluk — müsait nöbetçi yok" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<% if @gap_report.findings.any? %>
  <section>
    <h2>Önümüzdeki 7 günde nöbet boşlukları</h2>
    <ul>
      <% @gap_report.findings.each do |schedule, gaps| %>
        <li>
          <%= link_to schedule.name, schedule %>:
          <%= gaps.map { |gap| "#{format_time(gap.begin)} – #{format_time(gap.end)}" }.join(", ") %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section>
  <h2>Açık alarmlar</h2>
  <% if @open_alerts.any? %>
    <%= render "alerts/table", alerts: @open_alerts %>
  <% else %>
    <p>Açık alarm yok.</p>
  <% end %>
</section>
