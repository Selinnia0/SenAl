<% content_for :title, "Zaman sıçraması" %>

<h1>Zaman sıçraması</h1>
<p>
  Eskalasyonu (5 dk) veya bayatlamış "Gördüm"ü (4 saat) beklemeden görmek için açık olayları ileri sarın.
  Açık olayların bütün zamanları girilen süre kadar geriye kaydırılır ve her eskalasyon anında gerçek
  eskalasyon kuralları çalışır; sanki o kadar süre geçmiş gibi olur.
</p>
<p><small>
  Sunucu saati değişmez. Nöbet rotasyonu, izinler ve akademik takvim gerçek saate göre hesaplanmaya devam eder.
  Çözülmüş olaylara dokunulmaz. Bu bir demo/test aracıdır.
</small></p>

<%= render "shared/errors", record: @time_skip %>

<%= form_with model: @time_skip, url: time_skip_path do |form| %>
  <%= form.label :minutes, "Kaç dakika ileri sarılsın? (1–#{TimeSkip::MAX_MINUTES})" %>
  <%= form.number_field :minutes, min: 1, max: TimeSkip::MAX_MINUTES, required: true %>
  <%= form.submit "İleri sar" %>
<% end %>

<div class="inline-actions">
  <% TimeSkipsController::PRESETS.each do |minutes| %>
    <%= button_to (minutes < 60 ? "+#{minutes} dk" : "+#{minutes / 60} saat"), time_skip_path,
                  params: { time_skip: { minutes: minutes } } %>
  <% end %>
</div>

<section>
  <h2>Açık olaylar</h2>
  <% if @open_incidents.any? %>
    <div style="overflow-x: auto">
      <table>
        <thead>
          <tr><th>#</th><th>Başlık</th><th>Durum</th><th>Seviye / tur</th><th>Atanan</th><th>Sonraki eskalasyon</th></tr>
        </thead>
        <tbody>
          <% @open_incidents.each do |incident| %>
            <tr>
              <td><%= link_to incident.id, incident %></td>
              <td><%= link_to incident.title, incident %></td>
              <td><%= status_tag(incident) %></td>
              <td><%= incident.current_level + 1 %> / <%= incident.escalation_round + 1 %></td>
              <td><%= incident.assignee&.name || "—" %></td>
              <td><%= format_time(incident.escalate_at) || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>Açık olay yok. Servisler sayfasındaki <code>curl</code> komutuyla bir alarm gönderin.</p>
  <% end %>
</section>
