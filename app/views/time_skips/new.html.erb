<% content_for :title, "Zaman sıçraması" %>

<%= render layout: "components/page_header", locals: { eyebrow: "Yönetim · demo aracı", title: "Zaman sıçraması",
      lead: "Zaman kurallarını beklemeden görmek için ileri sarın: eskalasyon (5 dk), bayatlama (4 saat), güncelleme gecikmesi (30/60 dk), postmortem (5 gün), durum sayfası geçmişi (7 gün)." } do %>
<% end %>

<div class="detail-grid">
  <div>
    <h2 style="margin-top: 0">Açık alarmlar</h2>
    <% if @open_alerts.any? %>
      <%= render "alerts/table", alerts: @open_alerts %>
    <% else %>
      <p class="muted">Açık alarm yok. Servisler sayfasından deneme alarmı gönderin.</p>
    <% end %>

    <h2>Aktif olaylar</h2>
    <% if @active_incidents.any? %>
      <%= render "incidents/table", incidents: @active_incidents %>
    <% else %>
      <p class="muted">Aktif olay yok.</p>
    <% end %>
  </div>

  <aside aria-label="İleri sar">
    <%= render layout: "components/card", locals: { title: "İleri sar" } do %>
      <%= render "shared/errors", record: @time_skip %>
      <%= form_with model: @time_skip, url: time_skip_path do |form| %>
        <div class="field">
          <%= form.label :minutes, "Dakika (1–#{TimeSkip::MAX_MINUTES})" %>
          <%= form.number_field :minutes, min: 1, max: TimeSkip::MAX_MINUTES, required: true %>
        </div>
        <%= form.submit "İleri sar", class: btn_class(:primary, block: true) %>
      <% end %>
      <p class="eyebrow" style="margin-top: var(--sa-space-6)">Hızlı</p>
      <div class="preset-grid">
        <% TimeSkipsController::PRESETS.each do |minutes| %>
          <%= button_to (if minutes < 60 then "+#{minutes} dk" elsif minutes < 24 * 60 then "+#{minutes / 60} saat" else "+#{minutes / (24 * 60)} gün" end), time_skip_path,
                        params: { time_skip: { minutes: minutes } }, class: btn_class(:secondary, size: :sm, block: true) %>
        <% end %>
      </div>
    <% end %>

    <%= render layout: "components/card", locals: { title: "Nasıl çalışır?", muted: true } do %>
      <p class="muted">Sunucu saati değişmez. Açık alarmların ve olayların zamanları geriye kaydırılır, her kural anında gerçek kural metotları çalışır. Nöbet rotasyonu, izinler ve akademik takvim gerçek saate göre hesaplanır.</p>
    <% end %>
  </aside>
</div>
