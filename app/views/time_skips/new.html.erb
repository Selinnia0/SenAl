<% content_for :title, "Zaman sıçraması" %>

<h1>Zaman sıçraması</h1>
<p>
  Eskalasyonu (5 dk) veya bayatlamış "Gördüm"ü (4 saat) beklemeden görmek için açık alarmları ileri sarın.
  Açık alarmların bütün zamanları girilen süre kadar geriye kaydırılır ve her eskalasyon anında gerçek
  eskalasyon kuralları çalışır; sanki o kadar süre geçmiş gibi olur.
</p>
<p><small>
  Sunucu saati değişmez. Nöbet rotasyonu, izinler ve akademik takvim gerçek saate göre hesaplanmaya devam eder.
  Çözülmüş alarmlara dokunulmaz. Bu bir demo/test aracıdır.
</small></p>

<%= render "shared/errors", record: @time_skip %>

<%= form_with model: @time_skip, url: time_skip_path do |form| %>
  <%= form.label :minutes, "Kaç dakika ileri sarılsın? (1–#{TimeSkip::MAX_MINUTES})" %>
  <%= form.number_field :minutes, min: 1, max: TimeSkip::MAX_MINUTES, required: true %>
  <%= form.submit "İleri sar" %>
<% end %>

<div class="inline-actions">
  <% TimeSkipsController::PRESETS.each do |minutes| %>
    <%= button_to (minutes < 60 ? "+#{minutes} dk" : "+#{minutes / 60} saat"), time_skip_path,
                  params: { time_skip: { minutes: minutes } } %>
  <% end %>
</div>

<section>
  <h2>Açık alarmlar</h2>
  <% if @open_alerts.any? %>
    <div style="overflow-x: auto">
      <table>
        <thead>
          <tr><th>#</th><th>Başlık</th><th>Durum</th><th>Seviye / tur</th><th>Atanan</th><th>Sonraki eskalasyon</th></tr>
        </thead>
        <tbody>
          <% @open_alerts.each do |alert| %>
            <tr>
              <td><%= link_to alert.id, alert %></td>
              <td><%= link_to alert.title, alert %></td>
              <td><%= status_tag(alert) %></td>
              <td><%= alert.current_level + 1 %> / <%= alert.escalation_round + 1 %></td>
              <td><%= alert.assignee&.name || "—" %></td>
              <td><%= format_time(alert.escalate_at) || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>Açık alarm yok. Servisler sayfasındaki <code>curl</code> komutuyla bir alarm gönderin.</p>
  <% end %>
</section>
