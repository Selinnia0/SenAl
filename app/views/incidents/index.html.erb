<% content_for :title, "Olaylar" %>

<h1>Olaylar</h1>

<nav>
  <ul>
    <li><%= link_to_unless @status.nil?, "Tümü", incidents_path %></li>
    <% Incident.statuses.each_key do |status| %>
      <li><%= link_to_unless @status == status, t("enums.incident.status.#{status}"), incidents_path(status: status) %></li>
    <% end %>
  </ul>
</nav>

<% if @incidents.any? %>
  <%= render "incidents/table", incidents: @incidents %>
<% else %>
  <p>Bu durumda olay yok.</p>
<% end %>
