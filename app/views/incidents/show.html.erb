<% content_for :title, "Olay ##{@incident.id}" %>

<article>
  <header>
    <h1>#<%= @incident.id %> <%= @incident.title %></h1>
    <%= status_tag(@incident) %> · Aciliyet: <%= enum_label(@incident, :urgency) %>
  </header>

  <dl>
    <dt>Servis</dt>
    <dd><%= @incident.service.name %></dd>
    <dt>Tekilleştirme anahtarı</dt>
    <dd><code><%= @incident.dedup_key %></code></dd>
    <dt>Atanan</dt>
    <dd><%= @incident.assignee&.name || "—" %></dd>
    <dt>Eskalasyon</dt>
    <dd>
      Seviye <%= @incident.current_level + 1 %>, tur <%= @incident.escalation_round + 1 %>
      <% if @incident.escalate_at %>
        · bir sonraki eskalasyon: <%= format_time(@incident.escalate_at) %>
      <% end %>
    </dd>
    <dt>Açılış</dt>
    <dd><%= format_time(@incident.triggered_at) %></dd>
    <% if @incident.acknowledged_at %>
      <dt>Görülme</dt>
      <dd><%= format_time(@incident.acknowledged_at) %></dd>
    <% end %>
    <% if @incident.resolved_at %>
      <dt>Çözülme</dt>
      <dd><%= format_time(@incident.resolved_at) %></dd>
    <% end %>
  </dl>

  <% if @incident.can_acknowledge? || @incident.can_resolve? %>
    <footer class="inline-actions">
      <% if @incident.can_acknowledge? %>
        <%= button_to "Gördüm", acknowledge_incident_path(@incident) %>
      <% end %>
      <% if @incident.can_resolve? %>
        <%= button_to "Çözüldü", resolve_incident_path(@incident) %>
      <% end %>
    </footer>
  <% end %>
</article>

<section>
  <h2>Zaman çizelgesi</h2>
  <ol>
    <% @incident.incident_events.includes(:user).each do |event| %>
      <li>
        <time datetime="<%= event.occurred_at.iso8601 %>"><%= format_time(event.occurred_at) %></time>
        — <strong><%= event_label(event) %></strong>
        <% if event.user %> · <%= event.user.name %><% end %>
        <% if (description = event_description(event)) %> · <%= description %><% end %>
      </li>
    <% end %>
  </ol>
</section>
